  "subgraph_migration": {
    "current_status": "Blocked by BUG-002",
    "target": "Switch from single-node to subgraph-based stream processing",
    "benefits": [
      "Better separation of concerns",
      "Easier to add tool-specific rendering",
      "More maintainable parsing logic",
      "Parallel processing opportunities"
    ],
    "blocker": "Subgraph produces empty render_queue when integrated with main graph",
    "tasks": [
      {
        "id": "SUBGRAPH-001",
        "name": "Debug subgraph integration",
        "priority": "P0",
        "status": "blocked",
        "blocked_by": ["BUG-002"],
        "description": "Identify and fix root cause of empty render_queue in integrated subgraph",
        "steps": [
          "Add comprehensive logging to state transformations",
          "Compare chunk structure between mock and live data",
          "Verify render_queue merging logic",
          "Test with minimal subgraph first",
          "Gradually add complexity until failure point found"
        ],
        "acceptance_criteria": [
          "Subgraph produces identical output to single-node",
          "All tests pass with subgraph enabled",
          "No performance degradation",
          "State flows correctly through boundary"
        ]
      },
      {
        "id": "SUBGRAPH-002",
        "name": "Production switchover",
        "priority": "P1",
        "status": "blocked",
        "blocked_by": ["SUBGRAPH-001"],
        "description": "Switch graph/__init__.py to use builder_subgraph instead of builder.py",
        "steps": [
