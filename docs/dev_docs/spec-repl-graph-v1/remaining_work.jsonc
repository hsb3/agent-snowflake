      "features": [
        "Typing indicator during streaming",
        "Live token count updates",
        "Connection status indicator",
        "Current agent/thread context",
        "Configurable visibility",
        "Auto-hide when idle for >2s"
      ],
      "acceptance_criteria": [
        "Status bar appears during streaming",
        "Token count updates in real-time",
        "Connection status reflects client state",
        "Auto-hides when conversation is idle",
        "Configurable via REPL_SHOW_STATUS_BAR env var",
