        "src/repl_client_graph/graph/nodes/commands.py"
      ],
      "completion_types": [
        {
          "context": "Command names",
          "example": "/ag<Tab> → /agents",
          "implementation": "WordCompleter from command registry"
        },
        {
          "context": "Agent IDs",
          "example": "/agents agen<Tab> → /agents agent_enhanced",
          "implementation": "Dynamic completer querying client.list_agents()"
        },
        {
          "context": "Thread IDs",
          "example": "/threads abc<Tab> → /threads abc-123-def",
          "implementation": "Dynamic completer from session history"
        },
        {
          "context": "File paths",
          "example": "/export ~/Doc<Tab> → ~/Documents/",
          "implementation": "PathCompleter for file operations"
        }
      ],
      "acceptance_criteria": [
        "Tab completes all registered commands",
        "Agent completion shows available agents from server",
        "Thread completion shows recent threads",
        "Completion shows helpful descriptions",
        "Works with partial matches",
        "Case-insensitive matching"
