    {
      "id": "P3-004",
      "name": "Session persistence and replay",
      "priority": "P2",
      "description": "Save conversation history to disk for later review, debugging, and replay. Export sessions to markdown or JSON.",
      "dependencies": [],
      "files": [
        "src/repl_client_graph/persistence/ (new module)",
        "src/repl_client_graph/graph/nodes/session.py"
      ],
      "features": [
        "Auto-save conversations to .repl/sessions/",
        "Session files include metadata (agent, thread, timestamps)",
        "/replay <session_id> command to review past conversations",
        "/export command to save as markdown or JSON",
        "Checkpoint support for debugging state transitions",
        "Session search by date, agent, or content"
      ],
      "storage_format": {
        "location": ".repl/sessions/YYYY-MM-DD/session_<timestamp>.json",
        "schema": {
          "session_id": "uuid",
          "started_at": "ISO timestamp",
          "agent_id": "string",
          "thread_id": "string",
          "messages": [
            {
              "timestamp": "ISO",
              "role": "user|assistant",
              "content": "string",
              "metadata": {}
            }
          ],
          "commands": ["list of commands executed"],
          "tokens_used": {"input": 0, "output": 0, "total": 0}
        }
      },
      "commands": [
        {
          "command": "/sessions",
          "description": "List saved sessions",
          "syntax": "/sessions [--date YYYY-MM-DD] [--agent agent_id]"
        },
        {
          "command": "/replay",
          "description": "Display saved session",
          "syntax": "/replay <session_id>"
        },
        {
          "command": "/export",
          "description": "Export current session",
          "syntax": "/export [--format md|json] [--output path]"
        }
      ],
      "acceptance_criteria": [
        "Sessions auto-save during conversation",
        "Session files are human-readable JSON",
        "/sessions lists all saved sessions",
        "/replay displays session conversation",
        "/export creates markdown or JSON file",
        "Export includes all metadata and token stats"
      ]
    }
  ],

