          "Verify all features work identically",
          "Run full test suite",
          "Monitor performance metrics",
          "Update documentation"
        ],
        "rollback_plan": "Keep builder.py as fallback, easy revert by changing import",
        "acceptance_criteria": [
          "All Phase 1 & 2 features work with subgraph",
          "No user-visible changes in behavior",
          "Performance within 10% of single-node",
