        "src/repl_client_graph/graph/nodes/input.py",
        "src/repl_client_graph/ui/input_handler.py (new)"
      ],
      "requirements": [
        "prompt-toolkit>=3.0.0"
      ],
      "features": [
        "Multi-line input support (Ctrl+Enter to send, Enter for newline)",
        "Input history navigation (up/down arrows)",
        "Command completion (Tab key)",
        "Syntax highlighting in input area",
        "Vi/Emacs keybindings support",
        "Custom prompt styling"
      ],
      "acceptance_criteria": [
        "Multi-line messages can be composed and sent",
        "Up/down arrows navigate input history",
        "Tab completes commands and arguments",
        "Input area has subtle syntax highlighting",
        "Ctrl+C cancels current input without exiting",
        "History persists across sessions"
      ],
      "implementation_notes": [
        "Create InputHandler class wrapping PromptSession",
        "Update input_node to use InputHandler instead of input()",
        "Store history in .repl/input_history",
        "Register completer with command registry"
      ]
    },
    {
      "id": "P3-002",
