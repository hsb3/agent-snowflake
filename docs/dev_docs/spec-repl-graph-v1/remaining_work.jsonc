{
  // REPL Client Graph - Remaining Development Work
  // StateGraph-based terminal REPL for LangGraph dev server
  // Reference: docs/dev_docs/spec-repl-graph/GRAPH_REPL_TODO.md

  "project": {
    "name": "repl_client_graph",
    "description": "LangGraph StateGraph-based Terminal REPL Client",
    "current_status": "Phase 1 & 2 Complete - Functional with bugs, Phase 3 & optimizations needed",
    "version": "0.2.0-alpha",
    "phase": "2.5 - Bug fixes before Phase 3",
    "architecture": "StateGraph with single-node stream processing",
    "path": "src/repl_client_graph/"
  },

  "critical_bugs": [
    {
      "id": "BUG-001",
      "title": "Token tracking shows zero despite usage metadata in stream",
      "description": "Session summary displays 'Tokens Used: 0' even though usage_metadata is present in streaming chunks. Token tracking appears broken in the state flow between stream processing and session updates.",
      "priority": "P0",
      "severity": "high",
      "files_affected": [
        "src/repl_client_graph/graph/nodes/streaming.py:110-117",
        "src/repl_client_graph/graph/nodes/session.py"
      ],
      "root_cause_hypothesis": [
        "usage_metadata not being extracted from chunks",
        "Session state not being updated with token counts",
        "State transformation losing usage data",
        "Incorrect field names in usage extraction"
      ],
      "investigation_steps": [
        "Add debug logging to process_stream_node to inspect usage_metadata structure",
        "Verify usage flows through to update_session_node",
        "Check if usage_metadata field names match server response",
        "Trace token count through entire state pipeline"
      ],
      "acceptance_criteria": [
        "Session summary shows correct token counts",
        "/info command displays accurate usage stats",
        "Token tracking updates incrementally during streams",
        "Test with multiple messages to verify accumulation"
      ]
    },
    {
      "id": "BUG-002",
      "title": "Subgraph integration produces empty render queue",
      "description": "Stream processing subgraph works in standalone tests with mock data but produces 0 render items when integrated into main graph. State transformation or chunk structure mismatch suspected.",
      "priority": "P1",
      "severity": "high",
      "blocker_for": ["SUBGRAPH-001", "SUBGRAPH-002"],
      "files_affected": [
        "src/repl_client_graph/graph/builder_subgraph.py",
        "src/repl_client_graph/graph/subgraphs/stream_processor.py",
        "src/repl_client_graph/graph/nodes/streaming.py"
      ],
      "works": "Standalone subgraph with mock data produces correct output",
      "fails": "Integration with main graph produces empty render_queue",
      "root_cause_hypothesis": [
        "State transformation issues in transform_to_subgraph_input/output",
        "Chunk data structure differs between mock and live server",
        "Render queue not being properly merged back into main state",
        "Namespace or context loss during subgraph invocation"
      ],
      "investigation_steps": [
        "Compare mock chunk structure with live server chunks byte-for-byte",
        "Log state before/after subgraph invocation",
        "Verify transform functions preserve all required fields",
        "Test subgraph with live server data in isolation",
        "Check if render_queue gets overwritten after subgraph return"
      ],
      "acceptance_criteria": [
        "Subgraph produces same render output as single-node approach",
        "All streaming features work identically",
        "State flows correctly through subgraph boundary",
        "No data loss in transformation functions"
      ]
    }
  ],

  "phase_2_completion": [
    {
      "id": "P2-001",
      "name": "End-to-end HITL testing",
      "priority": "P0",
      "status": "not_tested",
      "description": "HITL infrastructure is implemented but not fully tested with real agent interrupts. Need to configure agents with interrupt_before settings and test complete approval/rejection flows.",
      "dependencies": [],
      "files": [
        "src/repl_client_graph/graph/nodes/hitl.py",
        "src/repl_client_graph/core/client.py"
      ],
      "tasks": [
        "Configure test agent with 'interrupt_before: [\"*\"]' in langgraph.json",
        "Trigger tool call requiring approval (e.g., database query)",
        "Test approval flow - type 'y' and verify execution continues",
        "Test rejection flow - type 'n' and verify graceful handling",
        "Verify resume streaming works after approval",
        "Test multiple interrupts in single conversation",
        "Verify state consistency after interrupt/resume cycles"
      ],
      "acceptance_criteria": [
        "Approval prompt appears when tool requires confirmation",
        "Typing 'y' approves and continues execution",
        "Typing 'n' rejects and returns to prompt",
        "Tool results display after approval",
        "Session state remains consistent through interrupt cycles",
        "Multiple interrupts in one stream work correctly"
      ],
      "test_agent_config": {
        "file": ".langgraph/config/test_hitl_agent.json",
        "example": {
          "assistant_id": "test_hitl",
          "graph_id": "agent_enhanced",
          "config": {
            "interrupt_before": ["*"]
          }
        }
      }
    },
    {
      "id": "P2-002",
      "name": "Fix state update message verbosity",
      "priority": "P1",
      "status": "needs_fix",
      "description": "Too many '[State Update: X keys changed]' messages clutter the conversation. Should be hidden by default or made much less prominent.",
      "dependencies": [],
      "files": [
        "src/repl_client_graph/graph/nodes/rendering.py:77-84",
        "src/repl_client_graph/core/config.py"
      ],
      "solutions": [
        {
          "option": "A",
          "description": "Add REPL_SHOW_STATE_UPDATES env var (default: false)",
          "pros": "User control, clean conversation by default",
          "cons": "Requires config change"
        },
        {
          "option": "B",
          "description": "Only show in debug/verbose mode (/debug on)",
          "pros": "Runtime toggle, no config needed",
          "cons": "Requires debug command implementation"
        },
        {
          "option": "C",
          "description": "Make dimmer/gray/less prominent",
          "pros": "Still visible but unobtrusive",
          "cons": "Still adds noise"
        }
      ],
      "recommended": "Option A - env var with default false",
      "acceptance_criteria": [
        "State update messages hidden by default",
        "Configurable via REPL_SHOW_STATE_UPDATES env var",
        "When enabled, messages are dimmed/gray",
        "Debug mode override still available"
      ]
    }
  ],

  "phase_3_features": [
    {
      "id": "P3-001",
      "name": "Enhanced input with prompt-toolkit",
      "priority": "P0",
      "description": "Replace basic input() with prompt-toolkit for rich terminal input experience. Multi-line editing, history, syntax highlighting, and better UX.",
      "dependencies": [],
