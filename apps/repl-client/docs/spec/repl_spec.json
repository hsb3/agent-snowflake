{
  "project": {
    "name": "agent-snowflake REPL Client",
    "vision": "Terminal client for LangGraph dev server. Simple, fast, chat-focused.",
    "scope": "Client only - not an agent builder",
    "version": "0.1.0"
  },

  "features": [
    {
      "id": "F001",
      "name": "Connect to LangGraph server",
      "priority": "P0",
      "phase": 1,
      "status": "planned",
      "acceptance": "Successfully connects to localhost:PORT from .env",
      "dependencies": [],
      "estimate_hours": 2
    },
    {
      "id": "F002",
      "name": "Send message and stream response",
      "priority": "P0",
      "phase": 1,
      "status": "planned",
      "acceptance": "User types message, sees streamed agent response",
      "dependencies": ["F001"],
      "estimate_hours": 4
    },
    {
      "id": "F003",
      "name": "Markdown rendering",
      "priority": "P0",
      "phase": 1,
      "status": "planned",
      "acceptance": "Bold, italic, headers, lists render correctly",
      "dependencies": ["F002"],
      "estimate_hours": 2
    },
    {
      "id": "F004",
      "name": "Code block syntax highlighting",
      "priority": "P1",
      "phase": 1,
      "status": "planned",
      "acceptance": "Python/JS/SQL blocks show language-specific colors",
      "dependencies": ["F003"],
      "estimate_hours": 2
    },
    {
      "id": "F005",
      "name": "Basic commands (/help, /exit)",
      "priority": "P0",
      "phase": 1,
      "status": "planned",
      "acceptance": "/help shows commands, /exit quits cleanly",
      "dependencies": [],
      "estimate_hours": 1
    },
    {
      "id": "F006",
      "name": "Thread management (/threads, /new)",
      "priority": "P1",
      "phase": 2,
      "status": "planned",
      "acceptance": "List threads, create new, resume existing",
      "dependencies": ["F001"],
      "estimate_hours": 4
    },
    {
      "id": "F007",
      "name": "Agent selection (/agents)",
      "priority": "P1",
      "phase": 2,
      "status": "planned",
      "acceptance": "List available agents, switch between them",
      "dependencies": ["F001"],
      "estimate_hours": 3
    },
    {
      "id": "F008",
      "name": "HITL interrupt handling",
      "priority": "P1",
      "phase": 2,
      "status": "planned",
      "acceptance": "Show tool approval prompt, resume on approval",
      "dependencies": ["F002"],
      "estimate_hours": 6
    },
    {
      "id": "F009",
      "name": "Table rendering",
      "priority": "P2",
      "phase": 2,
      "status": "planned",
      "acceptance": "Markdown tables display with borders",
      "dependencies": ["F003"],
      "estimate_hours": 2
    },
    {
      "id": "F010",
      "name": "Enhanced input (prompt-toolkit)",
      "priority": "P2",
      "phase": 3,
      "status": "planned",
      "acceptance": "Command completion, multiline support, history",
      "dependencies": ["F005"],
      "estimate_hours": 4
    },
    {
      "id": "F011",
      "name": "Token usage display",
      "priority": "P2",
      "phase": 3,
      "status": "planned",
      "acceptance": "Show tokens used per message and total",
      "dependencies": ["F002"],
      "estimate_hours": 2
    },
    {
      "id": "F012",
      "name": "Error handling & reconnection",
      "priority": "P1",
      "phase": 3,
      "status": "planned",
      "acceptance": "Graceful failures, retry on disconnect",
      "dependencies": ["F001"],
      "estimate_hours": 3
    }
  ],

  "components": [
    {
      "name": "REPLLoop",
      "file": "__main__.py",
      "responsibility": "Main loop, input handling, command routing",
      "dependencies": ["RemoteClient", "CommandHandler", "Renderer"],
      "public_methods": ["run", "handle_input"],
      "state": "current_thread_id, current_agent"
    },
    {
      "name": "RemoteClient",
      "file": "client.py",
      "responsibility": "Wrapper around langgraph-sdk, connection management",
      "dependencies": ["langgraph-sdk"],
      "public_methods": ["connect", "list_agents", "list_threads", "create_thread", "stream_message"],
      "state": "client, server_url"
    },
    {
      "name": "StreamHandler",
      "file": "streaming.py",
      "responsibility": "Parse streaming chunks, handle interrupts, buffer tool calls",
      "dependencies": ["RemoteClient"],
      "public_methods": ["process_stream", "handle_interrupt"],
      "state": "tool_call_buffer, interrupt_state"
    },
    {
      "name": "Renderer",
      "file": "renderer.py",
      "responsibility": "Rich-based output: markdown, code blocks, tables, HITL prompts",
      "dependencies": ["rich"],
      "public_methods": ["render_message", "render_code_block", "render_table", "render_hitl_prompt"],
      "state": "console"
    },
    {
      "name": "CommandHandler",
      "file": "commands.py",
      "responsibility": "Execute slash commands",
      "dependencies": ["RemoteClient", "Renderer"],
      "public_methods": ["handle_command", "register_command"],
      "state": "command_registry"
    },
    {
      "name": "Config",
      "file": "config.py",
      "responsibility": "Load .env, provide defaults",
      "dependencies": ["python-dotenv"],
      "public_methods": ["get_server_url", "get_defaults"],
      "state": "settings"
    }
  ],

  "commands": [
    {
      "command": "/help",
      "description": "Show available commands",
      "syntax": "/help [command]",
      "phase": 1,
      "example": "/help threads"
    },
    {
      "command": "/exit",
      "description": "Exit REPL",
      "syntax": "/exit",
      "phase": 1,
      "example": "/exit"
    },
    {
      "command": "/agents",
      "description": "List and switch agents",
      "syntax": "/agents [agent_id]",
      "phase": 2,
      "example": "/agents agent_enhanced"
    },
    {
      "command": "/threads",
      "description": "List and resume threads",
      "syntax": "/threads [thread_id]",
      "phase": 2,
      "example": "/threads abc-123"
    },
    {
      "command": "/new",
      "description": "Start new thread",
      "syntax": "/new",
      "phase": 2,
      "example": "/new"
    },
    {
      "command": "/clear",
      "description": "Clear screen",
      "syntax": "/clear",
      "phase": 3,
      "example": "/clear"
    },
    {
      "command": "/tokens",
      "description": "Show token usage",
      "syntax": "/tokens",
      "phase": 3,
      "example": "/tokens"
    },
    {
      "command": "/info",
      "description": "Show session info (thread, agent, tokens)",
      "syntax": "/info",
      "phase": 2,
      "example": "/info"
    },
    {
      "command": "/session",
      "description": "Show full session state dump",
      "syntax": "/session",
      "phase": 3,
      "example": "/session"
    }
  ],

  "decisions": [
    {
      "id": "D001",
      "question": "Where to store REPL config?",
      "decision": ".env only (LANGGRAPH_DEV_SERVER_PORT)",
      "rationale": "Keep simple, reuse existing .env, no new config files",
      "alternatives_considered": ["repl.toml", "repl.json"],
      "status": "decided"
    },
    {
      "id": "D002",
      "question": "Sync or async client?",
      "decision": "Sync client with async streaming",
      "rationale": "Simpler REPL loop, easier error handling",
      "alternatives_considered": ["Full async"],
      "status": "decided"
    },
    {
      "id": "D003",
      "question": "Streaming mode?",
      "decision": "messages mode only",
      "rationale": "Simpler than dual-mode, sufficient for MVP",
      "alternatives_considered": ["messages + updates dual-mode"],
      "status": "decided"
    },
    {
      "id": "D004",
      "question": "State persistence?",
      "decision": "Client is stateless",
      "rationale": "Server manages threads/checkpoints, client just connects",
      "alternatives_considered": ["Local cache of threads"],
      "status": "decided"
    },
    {
      "id": "D005",
      "question": "MCP server handling?",
      "decision": "Server-side only, client renders results",
      "rationale": "Not building agent builder, just client",
      "alternatives_considered": ["Client-side MCP"],
      "status": "decided"
    },
    {
      "id": "D006",
      "question": "Agent configuration UI?",
      "decision": "Phase 3 - read-only display first",
      "rationale": "Not critical for MVP, add editing later",
      "alternatives_considered": ["Full config editor in Phase 1"],
      "status": "decided"
    },
    {
      "id": "D007",
      "question": "HITL approval style?",
      "decision": "Start with y/n prompt",
      "rationale": "Simple first, upgrade to arrow keys if needed",
      "alternatives_considered": ["Interactive menu (deepagents style)"],
      "status": "decided"
    },
    {
      "id": "D008",
      "question": "Entry point?",
      "decision": "python -m repl_client",
      "rationale": "Separate package, no install needed, works from repo, generic name for any LangGraph server",
      "alternatives_considered": ["CLI script in pyproject.toml", "agent_snowflake.repl (coupled)"],
      "status": "decided"
    },
    {
      "id": "D009",
      "question": "Should client remember last thread across sessions?",
      "decision": "No - client is stateless",
      "rationale": "History saved in server, client just connects",
      "alternatives_considered": ["Local cache of last thread"],
      "status": "decided"
    },
    {
      "id": "D010",
      "question": "Render images in terminal?",
      "decision": "Out of scope",
      "rationale": "Focus on text/code/markdown. Images are complex, low ROI",
      "alternatives_considered": ["iTerm2/Kitty protocols", "Show file paths only"],
      "status": "decided"
    },
    {
      "id": "D011",
      "question": "Support multiple simultaneous connections?",
      "decision": "No - single connection, but design to allow later",
      "rationale": "Keep simple for MVP, don't block future extension",
      "alternatives_considered": ["Multi-connection architecture"],
      "status": "decided"
    },
    {
      "id": "D012",
      "question": "Handle content blocks?",
      "decision": "Yes - render text, code, tool calls. No images.",
      "rationale": "Content blocks are core to agent output. Render what we can (text/code), skip images",
      "alternatives_considered": ["Skip all content blocks", "Full multimodal support"],
      "status": "decided"
    }
  ],

  "tech_stack": {
    "required": [
      {"name": "langgraph-sdk", "purpose": "Connect to LangGraph server", "version": ">=0.1.0"},
      {"name": "rich", "purpose": "Terminal formatting, markdown, syntax highlighting", "version": ">=13.0.0"},
      {"name": "python-dotenv", "purpose": "Load .env configuration", "version": ">=1.0.0"}
    ],
    "optional": [
      {"name": "prompt-toolkit", "purpose": "Enhanced input (Phase 3)", "version": ">=3.0.0"}
    ]
  },

  "file_structure": {
    "src/agent_snowflake/repl/": {
      "__init__.py": "Package marker",
      "__main__.py": "Entry point, REPLLoop class",
      "client.py": "RemoteClient wrapper",
      "streaming.py": "StreamHandler for parsing streams",
      "renderer.py": "Renderer for Rich output",
      "commands.py": "CommandHandler and registry",
      "config.py": "Config loading and defaults"
    }
  },

  "phases": {
    "phase_1": {
      "name": "Core REPL",
      "duration_days": 2,
      "features": ["F001", "F002", "F003", "F004", "F005"],
      "goal": "Basic working REPL with streaming"
    },
    "phase_2": {
      "name": "Features",
      "duration_days": 2,
      "features": ["F006", "F007", "F008", "F009"],
      "goal": "Thread/agent management, HITL"
    },
    "phase_3": {
      "name": "Polish",
      "duration_days": 1,
      "features": ["F010", "F011", "F012"],
      "goal": "Enhanced UX, error handling"
    }
  },

  "success_criteria": [
    {
      "metric": "Can connect to running server",
      "test": "Start server, run REPL, see connection message",
      "how": "make dev-server (terminal 1), python -m repl_client (terminal 2), or just: make repl",
      "phase": 1
    },
    {
      "metric": "Can send message and see response",
      "test": "Type 'hello', see agent response streamed",
      "how": "Type message at prompt, watch for token-by-token streaming",
      "phase": 1
    },
    {
      "metric": "/help and /exit work",
      "test": "Type /help, see commands. Type /exit, REPL quits.",
      "how": "Type /help, verify output. Type /exit, verify clean shutdown",
      "phase": 1
    },
    {
      "metric": "Code blocks render with color",
      "test": "Ask agent for Python example, verify syntax highlighting",
      "how": "Ask 'show me a python function', check keywords are colored",
      "phase": 1
    },
    {
      "metric": "Can list and switch agents",
      "test": "/agents shows list, /agents <id> switches agent",
      "how": "Type /agents, see 3 agents listed. Type /agents agent_enhanced, see switch confirmation",
      "phase": 2
    },
    {
      "metric": "Can create and resume threads",
      "test": "/new creates thread, /threads lists it, /threads <id> resumes",
      "how": "Type /new, note thread ID. Type /threads, see it listed. Type /threads <id>, resume conversation",
      "phase": 2
    },
    {
      "metric": "HITL approval works",
      "test": "Trigger tool call, see approval prompt, approve/reject works",
      "how": "Ask 'query the database', see tool approval prompt, type 'y', see query execute",
      "phase": 2
    }
  ]
}
