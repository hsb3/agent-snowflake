/* Layout section - Screen and container layout
 *
 * NOTE: This file is part of the modular CSS organization but is not directly
 * imported (Textual CSS doesn't support @import). Instead, this content is
 * included in index.tcss under the "LAYOUT" section.
 *
 * This file serves as documentation and reference for layout-related styles.
 */

/* Screen and container layout - THE MASTER BLUEPRINT */

/* Global app styling */
Screen {
    background: $surface;
}

/* Main content horizontal container */
#main-content {
    height: 1fr;
    width: 100%;
}

/* Messages container */
#messages {
    height: 1fr;
    width: 1fr;
    background: $surface;
    padding: 0 1;
    overflow-y: auto;
}

/* Chat input */
ChatInput {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 0;
    background: $surface;
    border: solid $primary;
}

ChatInput .input-row {
    height: auto;
    width: 100%;
}

ChatInput .input-prompt {
    width: 3;
    height: 1;
    padding: 0 1;
}

ChatInput ChatTextArea {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    border: none;
    background: transparent;
    padding: 0;
}

/* Status area - two lines between input and footer */
StatusArea {
    height: 2;
    background: $surface;
    border-top: solid $primary;
}

/* Status bar - legacy, kept for compatibility */
StatusBar {
    height: 1;
    background: $surface;
    border-top: solid $primary;
}

/* Header */
Header {
    background: $primary;
}

/* Footer */
Footer {
    background: $panel;
}
