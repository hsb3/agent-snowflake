/* =============================================================================
 * THEME - Carbon Design System Color Tokens
 * =============================================================================
 * Must be loaded FIRST - defines all variables used by other CSS files.
 * Colors based on Carbon Design System (IBM)
 * Source: https://carbondesignsystem.com/guidelines/color/usage/
 */

/* =============================================================================
 * Semantic Tokens - Dark Mode (Default)
 * ============================================================================= */

/* Surfaces (Gray scale) */
$surface-sunken:    #161616;  /* gray-100 */
$surface-primary:   #262626;  /* gray-90 */
$surface-secondary: #393939;  /* gray-80 */
$surface-tertiary:  #525252;  /* gray-70 */
$surface-overlay:   #393939;  /* gray-80 */

/* Text */
$text-primary:   #f4f4f4;  /* gray-10 */
$text-secondary: #c6c6c6;  /* gray-30 */
$text-tertiary:  #a8a8a8;  /* gray-40 */
$text-disabled:  #525252;  /* gray-70 */

/* Interactive (Blue scale) */
$interactive:        #0f62fe;  /* blue-60 */
$interactive-hover:  #4589ff;  /* blue-50 */
$interactive-active: #78a9ff;  /* blue-40 */

/* Borders */
$border-subtle:   #393939;  /* gray-80 */
$border-default:  #525252;  /* gray-70 */
$border-strong:   #8d8d8d;  /* gray-50 */
$border-focus:    #ffffff;  /* white */
$border-selected: #4589ff;  /* blue-50 */

/* Status */
$status-success: #42be65;  /* green-40 */
$status-error:   #da1e28;  /* red-60 */
$status-warning: #f1c21b;  /* yellow-30 */
$status-info:    #4589ff;  /* blue-50 */

/* =============================================================================
 * Semantic Tokens - Light Mode
 * ============================================================================= */

$surface-sunken-light:    #f4f4f4;  /* gray-10 */
$surface-primary-light:   #c6c6c6;  /* gray-30 */
$surface-secondary-light: #e0e0e0;  /* gray-20 */
$surface-tertiary-light:  #f4f4f4;  /* gray-10 */
$surface-overlay-light:   #c6c6c6;  /* gray-30 */

$text-primary-light:   #000000;  /* black */
$text-secondary-light: #161616;  /* gray-100 */
$text-tertiary-light:  #393939;  /* gray-80 */
$text-disabled-light:  #6f6f6f;  /* gray-60 */

$interactive-light:        #0f62fe;  /* blue-60 */
$interactive-hover-light:  #0043ce;  /* blue-70 */
$interactive-active-light: #002d9c;  /* blue-80 */

$border-subtle-light:   #a8a8a8;  /* gray-40 */
$border-default-light:  #8d8d8d;  /* gray-50 */
$border-strong-light:   #525252;  /* gray-70 */
$border-focus-light:    #0f62fe;  /* blue-60 */
$border-selected-light: #0f62fe;  /* blue-60 */

/* =============================================================================
 * Textual Built-in Overrides
 * ============================================================================= */

$surface:           #262626;  /* surface-primary */
$text:              #f4f4f4;  /* text-primary */
$text-muted:        #c6c6c6;  /* text-secondary */
$primary:           #0f62fe;  /* interactive */
$secondary:         #393939;  /* surface-secondary */
$accent:            #0f62fe;  /* interactive */
$success:           #42be65;  /* status-success */
$error:             #da1e28;  /* status-error */
$warning:           #f1c21b;  /* status-warning */
$surface-lighten-1: #393939;  /* surface-secondary */
$surface-lighten-2: #525252;  /* surface-tertiary */
$surface-darken-1:  #161616;  /* surface-sunken */
$primary-lighten-1: #4589ff;  /* interactive-hover */
$primary-darken-1:  #78a9ff;  /* interactive-active */
/* =============================================================================
 * LAYOUT - Screen and Container Structure
 * =============================================================================
 * Defines the structural layout of the application.
 * Depends on: theme.tcss (for variables)
 */

/* Global app styling - Dark Mode (default) */
Screen {
    background: $surface-primary;
}

/* Global app styling - Light Mode */
Screen:light {
    background: $surface-primary-light;
}

/* Main layout container - ensures proper vertical stacking */
LayoutView {
    layout: vertical;
    height: 100%;
    width: 100%;
}

/* Main content horizontal container */
#main-content {
    layout: horizontal;
    height: 1fr;
    width: 100%;
}

/* Messages container */
#message-area {
    height: 1fr;
    width: 1fr;
    background: $surface-primary;
    padding: 0 1;
    overflow-y: auto;
}

/* Chat input */
ChatInput {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 0;
    background: $surface-primary;
    border: solid $interactive;
}

ChatInput .input-row {
    height: auto;
    width: 100%;
}

ChatInput .input-prompt {
    width: 3;
    height: 1;
    padding: 0 1;
    color: $interactive;
    text-style: bold;
}

ChatInput ChatTextArea {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
    border: none;
    background: transparent;
    padding: 0;
}

/* Status area - two lines between input and footer */
StatusArea {
    layout: vertical;
    height: 3;
    width: 100%;
    background: $surface-primary;
    border-top: solid $interactive;
}

UserStatusLine {
    height: 1;
    width: 100%;
    background: $surface-primary;
    padding: 0 1;
}

UserStatusLine .status-agent {
    width: auto;
    padding: 0 1;
    color: $status-info;
}

UserStatusLine .status-thread {
    width: auto;
    padding: 0 1;
    color: $status-warning;
}

UserStatusLine .status-tokens {
    width: auto;
    padding: 0 1;
    color: $status-success;
}

UserStatusLine .status-divider {
    color: $text-secondary;
    padding: 0 1;
}

UserStatusLine .status-spacer {
    width: 1fr;
}

ClientInfoLine {
    height: 1;
    width: 100%;
    background: $surface-primary;
    padding: 0 1;
}

ClientInfoLine .status-connection {
    width: auto;
    padding: 0 1;
}

ClientInfoLine .status-last-update {
    width: auto;
    padding: 0 1;
    color: $text-secondary;
}

ClientInfoLine .status-message {
    width: auto;
    padding: 0 1;
    color: $text-primary;
}

ClientInfoLine .status-divider {
    color: $text-secondary;
    padding: 0 1;
}

ClientInfoLine .status-spacer {
    width: 1fr;
}

/* Status bar - legacy, kept for compatibility */
StatusBar {
    height: 1;
    background: $surface-primary;
    border-top: solid $interactive;
}

/* Header */
Header {
    background: $interactive;
}

/* Footer - keybindings display */
Footer {
    dock: bottom;
    height: 1;
    background: $surface-secondary;
}
/* =============================================================================
 * COMPONENTS - Widget Styling
 * =============================================================================
 * Individual widget appearance and styling.
 * Depends on: theme.tcss (for variables)
 */

/* =============================================================================
 * Messages
 * ============================================================================= */

/* User messages - green border */
UserMessage {
    height: auto;
    padding: 0 1;
    margin: 1 0;
    background: $surface-primary;
    border-left: thick $status-success;
}

/* Assistant messages - blue border */
AssistantMessage {
    height: auto;
    padding: 0 1;
    margin: 1 0;
}

AssistantMessage Markdown {
    padding: 0;
    margin: 0;
    border-left: thick $interactive;
}

/* Tool call messages - yellow border */
ToolCallMessage {
    height: auto;
    padding: 0 1;
    margin: 1 0;
    background: $surface-primary;
    border-left: thick $status-warning;
}

ToolCallMessage .tool-header {
    color: $status-warning;
    text-style: bold;
}

ToolCallMessage .tool-args {
    color: $text-secondary;
    margin-left: 2;
}

ToolCallMessage .tool-status {
    margin-left: 2;
}

ToolCallMessage .tool-output {
    margin-left: 2;
    margin-top: 1;
    padding: 1;
    background: $surface-tertiary;
    color: $text-secondary;
    max-height: 20;
    overflow-y: auto;
}

ToolCallMessage .tool-output-preview {
    margin-left: 2;
    color: $text-secondary;
}

ToolCallMessage .tool-output-hint {
    margin-left: 2;
    color: $status-info;
    text-style: italic;
}

/* System messages */
.system-message {
    height: auto;
    padding: 1;
    margin: 1 0;
    background: $surface-tertiary;
    border-left: thick $interactive;
    color: $text-primary;
}

/* Loading widget */
LoadingWidget {
    height: auto;
    padding: 0 1;
    margin: 1 0;
}

LoadingWidget .loading-spinner {
    color: $status-info;
    text-style: bold;
}

/* =============================================================================
 * Status Bar
 * ============================================================================= */

StatusBar .status-item {
    padding: 0 1;
}

StatusBar .status-agent {
    color: $status-info;
}

StatusBar .status-thread {
    color: $status-warning;
}

StatusBar .status-tokens {
    color: $status-success;
}

StatusBar .status-message {
    color: $text-primary;
}

/* =============================================================================
 * Schema Viewer
 * ============================================================================= */

SchemaViewer {
    padding: 1;
    height: 100%;
    background: $surface-primary;
}

SchemaViewer .schema-header {
    text-style: bold;
    color: $text-primary;
    margin-bottom: 1;
    padding: 1;
    background: $surface-secondary;
}

SchemaViewer .schema-empty {
    color: $text-tertiary;
    padding: 2;
    text-align: center;
}

SchemaViewer .schema-graph-id {
    color: $interactive;
    margin-bottom: 1;
}

SchemaFieldWidget {
    padding: 1 2;
    margin: 0 0 1 0;
    background: $surface-secondary;
    border: solid $border-subtle;
}

SchemaFieldWidget .field-name {
    text-style: bold;
    color: $text-primary;
}

SchemaFieldWidget .field-type {
    color: $interactive;
    margin-left: 1;
}

SchemaFieldWidget .field-default {
    color: $status-success;
    margin-left: 1;
}

SchemaFieldWidget .field-description {
    color: $text-secondary;
    margin-top: 1;
}

/* =============================================================================
 * Agent Detail Widgets
 * ============================================================================= */

AgentDetailItem {
    padding: 1;
    margin: 0 0 1 0;
    background: $surface-secondary;
    border: solid $border-subtle;
}

AgentDetailItem .agent-name {
    text-style: bold;
    color: $text-primary;
}

AgentDetailItem .agent-id {
    color: $text-secondary;
    text-style: italic;
}

AgentDetailItem .agent-meta {
    color: $text-tertiary;
}

AgentDetailList {
    height: 100%;
    padding: 1;
    background: $surface-primary;
}

AgentSelector {
    height: 100%;
    width: 100%;
}
/* =============================================================================
 * SIDEBAR - Sidebar Widget Styling
 * =============================================================================
 * Tabbed sidebar for threads, agents, session info, and tools.
 * Depends on: theme.tcss (for variables)
 */

Sidebar {
    width: 0;
    height: 1fr;
    background: $surface-primary;
    border-left: solid $interactive;
    display: none;
}

Sidebar.visible {
    width: 40%;
    display: block;
}

Sidebar.expanded {
    width: 60%;
    display: block;
}

Sidebar TabbedContent {
    height: 1fr;
    width: 100%;
}

Sidebar TabPane {
    padding: 1;
}

/* Thread items */
Sidebar .thread-item {
    padding: 0 1;
    margin: 0 0 1 0;
    background: $surface-primary;
    height: auto;
}

Sidebar .thread-item:hover {
    background: $surface-secondary;
}

Sidebar .thread-item.current {
    background: $interactive;
}

/* Agent items */
Sidebar .agent-item {
    padding: 0 1;
    margin: 0 0 1 0;
    background: $surface-primary;
    height: auto;
}

Sidebar .agent-item:hover {
    background: $surface-secondary;
}

Sidebar .agent-item.current {
    background: $interactive;
}

/* Session info */
Sidebar .session-info {
    padding: 1;
    background: $surface-primary;
}

/* Tool call items */
Sidebar .tool-call-item {
    padding: 0 1;
    margin: 0 0 1 0;
    background: $surface-primary;
}

Sidebar .tool-call-item:hover {
    background: $surface-secondary;
}
/* =============================================================================
 * MODALS - Modal Screen Styling
 * =============================================================================
 * Command palette, selection screens, and configuration modals.
 * Depends on: theme.tcss (for variables)
 */

/* =============================================================================
 * Command Palette
 * ============================================================================= */

CommandPalette {
    align: center middle;
}

CommandPalette > Container {
    width: 80;
    height: auto;
    max-height: 30;
    background: $surface-secondary;
    border: thick $interactive;
    padding: 1;
}

CommandPalette Input {
    width: 100%;
    margin-bottom: 1;
    border: solid $interactive;
}

CommandPalette Label {
    width: 100%;
    margin-bottom: 1;
    text-align: center;
    color: $text-secondary;
    text-style: italic;
}

CommandPalette OptionList {
    width: 100%;
    height: auto;
    max-height: 20;
    border: none;
    background: $surface-primary;
}

CommandPalette OptionList > .option-list--option {
    padding: 0 1;
}

CommandPalette OptionList > .option-list--option-highlighted {
    background: $interactive;
}

CommandPalette .command-category {
    color: $interactive;
    text-style: bold;
    padding: 1 0 0 0;
}

CommandPalette .command-label {
    text-style: bold;
}

CommandPalette .command-description {
    color: $text-secondary;
    text-style: italic;
}

/* =============================================================================
 * Agent Selection Screen
 * ============================================================================= */

AgentSelectionScreen {
    align: center middle;
}

AgentSelectionScreen > Container {
    width: 60;
    height: auto;
    max-height: 25;
    background: $surface-secondary;
    border: thick $interactive;
    padding: 1;
}

AgentSelectionScreen Label {
    width: 100%;
    text-align: center;
    color: $text-secondary;
    text-style: italic;
    margin-bottom: 1;
}

AgentSelectionScreen OptionList {
    width: 100%;
    height: auto;
    max-height: 15;
    border: none;
    background: $surface-primary;
}

/* =============================================================================
 * Thread Selection Screen
 * ============================================================================= */

ThreadSelectionScreen {
    align: center middle;
}

ThreadSelectionScreen > Container {
    width: 70;
    height: auto;
    max-height: 30;
    background: $surface-secondary;
    border: thick $interactive;
    padding: 1;
}

ThreadSelectionScreen Label {
    width: 100%;
    text-align: center;
    color: $text-secondary;
    text-style: italic;
    margin-bottom: 1;
}

ThreadSelectionScreen OptionList {
    width: 100%;
    height: auto;
    max-height: 20;
    border: none;
    background: $surface-primary;
}

/* =============================================================================
 * Agent Config Screen
 * ============================================================================= */

AgentConfigScreen {
    align: center middle;
}

AgentConfigScreen > Container {
    width: 85%;
    height: 85%;
    background: $surface-secondary;
    border: thick $interactive;
    padding: 1;
    layout: vertical;
}

AgentConfigScreen .config-title {
    text-style: bold;
    color: $text-primary;
    padding: 1;
    text-align: center;
    border-bottom: solid $border-subtle;
    margin-bottom: 1;
}

AgentConfigScreen TabbedContent {
    height: 1fr;
}

AgentConfigScreen TabPane {
    height: 100%;
    padding: 0;
}

AgentConfigScreen .button-bar {
    height: auto;
    padding: 1;
    align: right middle;
    dock: bottom;
}

AgentConfigScreen Button {
    margin-left: 1;
}

AgentConfigScreen .placeholder-message {
    color: $text-secondary;
    padding: 4;
    text-align: center;
}

/* =============================================================================
 * Welcome Screen
 * ============================================================================= */

WelcomeScreen {
    align: center middle;
}

WelcomeScreen > Container {
    width: 70;
    height: auto;
    max-height: 80%;
    background: $surface-secondary;
    border: thick $interactive;
    padding: 1 2;
}

WelcomeScreen .welcome-title {
    text-align: center;
    text-style: bold;
    color: $interactive;
    padding: 1;
}

WelcomeScreen Markdown {
    margin: 1 0;
    padding: 0 1;
}

WelcomeScreen .button-bar {
    height: auto;
    align: center middle;
    padding: 1;
}

WelcomeScreen Button {
    margin: 0 1;
}
/* =============================================================================
 * STATES - Interactive State Styling
 * =============================================================================
 * Focus, hover, active, and status states.
 * Depends on: theme.tcss (for variables)
 */

/* =============================================================================
 * Focus States
 * ============================================================================= */

ChatInput ChatTextArea:focus {
    border: none;
}

Sidebar TabbedContent:focus-within {
    border: tall $interactive;
}

Sidebar .thread-item.focused {
    background: $surface-secondary;
    border-left: thick $interactive;
}

Sidebar .agent-item.focused {
    background: $surface-secondary;
    border-left: thick $interactive;
}

AgentDetailItem.focused {
    background: $surface-tertiary;
    border: solid $interactive;
}

AgentDetailItem.current {
    border-left: thick $status-success;
}

/* =============================================================================
 * Hover States
 * ============================================================================= */

ToolCallMessage:hover {
    background: $surface-secondary;
}

/* =============================================================================
 * Status States (Tool Calls)
 * ============================================================================= */

ToolCallMessage .tool-status.pending {
    color: $status-warning;
}

ToolCallMessage .tool-status.success {
    color: $status-success;
}

ToolCallMessage .tool-status.error {
    color: $status-error;
}

ToolCallMessage .tool-status.rejected {
    color: $status-warning;
}

/* =============================================================================
 * Connection States
 * ============================================================================= */

ClientInfoLine .status-connection.connected {
    color: $status-success;
}

ClientInfoLine .status-connection.disconnected {
    color: $status-error;
}

ClientInfoLine .status-message.error {
    color: $status-error;
}

ClientInfoLine .status-message.warning {
    color: $status-warning;
}

StatusBar .status-message.error {
    color: $status-error;
}
/* =============================================================================
 * LIGHT MODE - Light Theme Overrides
 * =============================================================================
 * All :light pseudo-class overrides for light mode support.
 * Depends on: theme.tcss (for light mode variables)
 */

/* =============================================================================
 * Layout - Light Mode
 * ============================================================================= */

Screen:light #message-area {
    background: $surface-primary-light;
}

Screen:light ChatInput {
    background: $surface-primary-light;
    border: solid $interactive-light;
}

Screen:light ChatInput .input-prompt {
    color: $interactive-light;
}

Screen:light StatusArea {
    background: $surface-primary-light;
    border-top: solid $interactive-light;
}

Screen:light UserStatusLine {
    background: $surface-primary-light;
}

Screen:light UserStatusLine .status-divider {
    color: $text-secondary-light;
}

Screen:light ClientInfoLine {
    background: $surface-primary-light;
}

Screen:light ClientInfoLine .status-last-update {
    color: $text-secondary-light;
}

Screen:light ClientInfoLine .status-message {
    color: $text-primary-light;
}

Screen:light ClientInfoLine .status-divider {
    color: $text-secondary-light;
}

Screen:light StatusBar {
    background: $surface-primary-light;
    border-top: solid $interactive-light;
}

Screen:light Header {
    background: $interactive-light;
}

Screen:light Footer {
    background: $surface-secondary-light;
}

/* =============================================================================
 * Components - Light Mode
 * ============================================================================= */

Screen:light UserMessage {
    background: $surface-primary-light;
}

Screen:light AssistantMessage Markdown {
    border-left: thick $interactive-light;
}

Screen:light ToolCallMessage {
    background: $surface-primary-light;
}

Screen:light ToolCallMessage .tool-args {
    color: $text-secondary-light;
}

Screen:light ToolCallMessage .tool-output {
    background: $surface-tertiary-light;
    color: $text-secondary-light;
}

Screen:light ToolCallMessage .tool-output-preview {
    color: $text-secondary-light;
}

Screen:light .system-message {
    background: $surface-tertiary-light;
    border-left: thick $interactive-light;
    color: $text-primary-light;
}

Screen:light StatusBar .status-message {
    color: $text-primary-light;
}

/* Schema Viewer */
Screen:light SchemaViewer {
    background: $surface-primary-light;
}

Screen:light SchemaViewer .schema-header {
    color: $text-primary-light;
    background: $surface-secondary-light;
}

Screen:light SchemaViewer .schema-empty {
    color: $text-tertiary-light;
}

Screen:light SchemaViewer .schema-graph-id {
    color: $interactive-light;
}

Screen:light SchemaFieldWidget {
    background: $surface-secondary-light;
    border: solid $border-subtle-light;
}

Screen:light SchemaFieldWidget .field-name {
    color: $text-primary-light;
}

Screen:light SchemaFieldWidget .field-type {
    color: $interactive-light;
}

Screen:light SchemaFieldWidget .field-description {
    color: $text-secondary-light;
}

/* Agent Detail Widgets */
Screen:light AgentDetailItem {
    background: $surface-secondary-light;
    border: solid $border-subtle-light;
}

Screen:light AgentDetailItem.focused {
    background: $surface-tertiary-light;
    border: solid $interactive-light;
}

Screen:light AgentDetailItem .agent-name {
    color: $text-primary-light;
}

Screen:light AgentDetailItem .agent-id {
    color: $text-secondary-light;
}

Screen:light AgentDetailItem .agent-meta {
    color: $text-tertiary-light;
}

Screen:light AgentDetailList {
    background: $surface-primary-light;
}

/* =============================================================================
 * States - Light Mode
 * ============================================================================= */

Screen:light ToolCallMessage:hover {
    background: $surface-secondary-light;
}

/* =============================================================================
 * Modals - Light Mode
 * ============================================================================= */

Screen:light CommandPalette > Container {
    background: $surface-secondary-light;
    border: thick $interactive-light;
}

Screen:light CommandPalette Input {
    border: solid $interactive-light;
}

Screen:light CommandPalette Label {
    color: $text-secondary-light;
}

Screen:light CommandPalette OptionList {
    background: $surface-primary-light;
}

Screen:light CommandPalette OptionList > .option-list--option-highlighted {
    background: $interactive-light;
}

Screen:light CommandPalette .command-category {
    color: $interactive-light;
}

Screen:light CommandPalette .command-description {
    color: $text-secondary-light;
}

Screen:light AgentSelectionScreen > Container {
    background: $surface-secondary-light;
    border: thick $interactive-light;
}

Screen:light AgentSelectionScreen Label {
    color: $text-secondary-light;
}

Screen:light AgentSelectionScreen OptionList {
    background: $surface-primary-light;
}

Screen:light ThreadSelectionScreen > Container {
    background: $surface-secondary-light;
    border: thick $interactive-light;
}

Screen:light ThreadSelectionScreen Label {
    color: $text-secondary-light;
}

Screen:light ThreadSelectionScreen OptionList {
    background: $surface-primary-light;
}

Screen:light AgentConfigScreen > Container {
    background: $surface-secondary-light;
    border: thick $interactive-light;
}

Screen:light AgentConfigScreen .config-title {
    color: $text-primary-light;
    border-bottom: solid $border-subtle-light;
}

Screen:light AgentConfigScreen .placeholder-message {
    color: $text-secondary-light;
}

/* =============================================================================
 * Sidebar - Light Mode
 * ============================================================================= */

Screen:light Sidebar {
    background: $surface-primary-light;
    border-left: solid $interactive-light;
}

Screen:light Sidebar TabbedContent:focus-within {
    border: tall $interactive-light;
}

Screen:light Sidebar .thread-item {
    background: $surface-primary-light;
}

Screen:light Sidebar .thread-item:hover {
    background: $surface-secondary-light;
}

Screen:light Sidebar .thread-item.current {
    background: $interactive-hover-light;
}

Screen:light Sidebar .thread-item.focused {
    background: $surface-tertiary-light;
    border-left: thick $interactive-light;
}

Screen:light Sidebar .agent-item {
    background: $surface-primary-light;
}

Screen:light Sidebar .agent-item:hover {
    background: $surface-secondary-light;
}

Screen:light Sidebar .agent-item.current {
    background: $interactive-hover-light;
}

Screen:light Sidebar .agent-item.focused {
    background: $surface-tertiary-light;
    border-left: thick $interactive-light;
}

Screen:light Sidebar .session-info {
    background: $surface-primary-light;
}

Screen:light Sidebar .tool-call-item {
    background: $surface-primary-light;
