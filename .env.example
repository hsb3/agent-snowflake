# Agent Configuration
SNOWFLAKE_AGENT_MODEL=claude-sonnet-4-5-20250929
SNOWFLAKE_AGENT_TEMPERATURE=0.0
SNOWFLAKE_AGENT_MAX_ITERATIONS=25
SNOWFLAKE_AGENT_ENABLE_DEBUG=false

# Snowflake Connection (Option 1: URI)
# SNOWFLAKE_AGENT_SNOWFLAKE_URI=snowflake://user:password@account/database/schema?warehouse=wh&role=role


# TESTING
# SNOWFLAKE_AGENT_SNOWFLAKE_URI=sqlite:////~/Developer/agent-snowflake/test_snowflake.db
SNOWFLAKE_AGENT_SNOWFLAKE_URI=sqlite:////~/Developer/agent-snowflake/test_chinook.db


# Snowflake Connection (Option 2: Individual parameters)
# For production Snowflake:
# SNOWFLAKE_AGENT_SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_AGENT_SNOWFLAKE_USER=your_user
# SNOWFLAKE_AGENT_SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_AGENT_SNOWFLAKE_DATABASE=your_database
# SNOWFLAKE_AGENT_SNOWFLAKE_SCHEMA=your_schema
# SNOWFLAKE_AGENT_SNOWFLAKE_WAREHOUSE=your_warehouse
# SNOWFLAKE_AGENT_SNOWFLAKE_ROLE=your_role

# Snowflake Connection (Option 3: Local Testing with SQLite)
# For quick local testing and development (run: make setup-test-db)
# ⚠️ Note: SQLite doesn't support Snowflake-specific features (VARIANT, FLATTEN, QUALIFY, etc.)
# For production Snowflake features, use Option 2 with actual Snowflake account
# SNOWFLAKE_AGENT_SNOWFLAKE_URI=sqlite:////absolute/path/to/test_snowflake.db

# Agent Guardrails
SNOWFLAKE_AGENT_ALLOWED_SCHEMAS=*
SNOWFLAKE_AGENT_ALLOWED_TABLES=*
SNOWFLAKE_AGENT_READ_ONLY=true
SNOWFLAKE_AGENT_QUERY_TIMEOUT=30

# API Keys (for LLM providers)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key

# Development Settings
SNOWFLAKE_AGENT_CORS_ORIGINS=*
SNOWFLAKE_AGENT_ENVIRONMENT=development
LANGGRAPH_DEV_SERVER_PORT=2024
